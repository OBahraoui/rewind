# Rewind configuration. Copy to .env and fill in. Never commit .env.
# Values marked (required) must be set before `rewind doctor` passes.

# ---------------------------------------------------------------------------
# GitLab
# ---------------------------------------------------------------------------
GITLAB_URL=https://gitlab.com

# (required) Personal access token with the `api` scope, from a user with the
# Maintainer role on the project. Rewind uses it to snapshot and restore state,
# start Duo flows, and merge. Create at: User settings > Access tokens.
GITLAB_TOKEN=

# (required) The hackathon project Rewind manages. Numeric ID (Settings > General)
# or the full path, e.g. gitlab-ai-hackathon/participants/1234/rewind.
GITLAB_PROJECT_ID=

# The top-level group / namespace ID the hackathon provisioned (shown in the
# group URL or on the group overview page). Used for flow lookups.
GITLAB_NAMESPACE_ID=

# (required) Random secret GitLab sends in X-Gitlab-Token on every webhook.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GITLAB_WEBHOOK_SECRET=

# Instance ID for GitLab Feature Flags (Deploy > Feature flags > Configure).
# The demo app reads flags with it; `rewind bootstrap` stores it as a masked CI/CD variable.
UNLEASH_INSTANCE_ID=

# ---------------------------------------------------------------------------
# Rewind engine and service
# ---------------------------------------------------------------------------
# Where snapshots, checkpoints, runs and rewind reports are stored.
#   file://.rewind          local directory (development)
#   gs://<bucket-name>      Google Cloud Storage (Cloud Run deployment)
REWIND_STORE=file://.rewind

# (required) Key for HMAC fingerprints of CI/CD variable values. Rewind never
# stores variable values, only keyed fingerprints, so a leaked snapshot cannot be
# brute-forced. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
REWIND_HASH_KEY=

# (required) Bearer token for Rewind's write endpoints (manual rewind, tick).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REWIND_API_TOKEN=

# Public base URL of the Rewind service (set after the first deploy). Used for
# links in ledgers and to register the project webhook.
REWIND_PUBLIC_URL=

# Reversibility policy. Defaults to the policy shipped in rewind/policy.yaml.
REWIND_POLICY_PATH=rewind/policy.yaml

# Label that hands an issue to the autonomous loop.
REWIND_TRIGGER_LABEL=rewind:auto

# Seconds between background reconcile ticks in the service.
REWIND_TICK_SECONDS=15

# ---------------------------------------------------------------------------
# Duo Agent Platform flows used by the autonomous loop
# Format: definition:<workflow_definition>, catalog:<ai_catalog_item_consumer_id>, or none
# `rewind spike` prints which of these work in your namespace.
# ---------------------------------------------------------------------------
# Planner: create flows/rewind_planner.yml as a custom flow, enable it, then set catalog:<id>.
REWIND_FLOW_PLAN=none
# Developer: foundational flow, or catalog:<id> of flows/rewind_release.yml.
REWIND_FLOW_DEVELOP=definition:developer/v1
REWIND_FLOW_REVIEW=definition:code_review/v1
REWIND_FLOW_FIX=definition:fix_pipeline/v1
# How many times the fix-pipeline flow may try before the run stops.
REWIND_MAX_FIX_ATTEMPTS=2
# Credit guard: the most flows Rewind may start per UTC day (each run uses ~3-5).
REWIND_MAX_FLOWS_PER_DAY=25

# ---------------------------------------------------------------------------
# Google Cloud (Cloud Run hosts the demo app and the Rewind service)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=europe-west1
# Artifact Registry Docker repository Cloud Run pulls images from.
GCP_ARTIFACT_REPO=rewind
# GCS bucket for the Rewind store when REWIND_STORE=gs://...
GCS_BUCKET=
# Cloud Run services for each GitLab environment of the demo app.
CLOUD_RUN_SERVICE_STAGING=rewind-demo-staging
CLOUD_RUN_SERVICE_PRODUCTION=rewind-demo-production
# Cloud Run service that runs Rewind itself.
CLOUD_RUN_SERVICE_REWIND=rewind
# Printed by infra/gcp-setup.sh:
GCP_WIF_PROVIDER=
GCP_DEPLOY_SERVICE_ACCOUNT=
CLOUD_RUN_APP_SERVICE_ACCOUNT=
REWIND_SERVICE_ACCOUNT=
# Local development only: Rewind calls `gcloud auth print-access-token` when this
# is empty and it is not running on Cloud Run.
GOOGLE_OAUTH_ACCESS_TOKEN=
